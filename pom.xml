<?xml version="1.0" encoding="UTF-8"?>
<!-- Root build for spring-boot-labs. You do NOT edit this file.
     It sets Java 21 and the Spring Boot version for every chapter. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>dev.ledgerly.labs</groupId>
  <artifactId>spring-boot-labs</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Ledgerly Spring Boot Labs</name>
  <description>Self-paced Spring Boot labs set in a retail bank</description>

  <properties>
    <java.version>21</java.version>
  </properties>

  <modules>
    <module>chapters/01-maven-and-the-pom</module>
    <module>chapters/02-first-spring-boot-app</module>
    <module>chapters/03-beans-and-the-application-context</module>
  </modules>
</project>
