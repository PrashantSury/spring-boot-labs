<?xml version="1.0" encoding="UTF-8"?>
<!-- Root build for spring-boot-labs. You do NOT edit this file.
     It sets Java 21 and the Spring Boot version for every chapter. -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>dev.ledgerly.labs</groupId>
  <artifactId>spring-boot-labs</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>Ledgerly Spring Boot Labs</name>
  <description>Self-paced Spring Boot labs set in a retail bank</description>

  <properties>
    <java.version>21</java.version>
    <!-- Open chapters (not solved yet) compile in a root build but skip their checks,
         so `mvn test` from the root stays green. Run an open chapter's checks with -Popen:
         mvn -pl chapters/04-dependency-injection test -Popen
         When a chapter is done, delete the skipTests line from its pom.xml. -->
    <labs.skipOpen>true</labs.skipOpen>
  </properties>

  <profiles>
    <profile>
      <id>open</id>
      <properties>
        <labs.skipOpen>false</labs.skipOpen>
      </properties>
    </profile>
  </profiles>

  <modules>
    <module>chapters/01-maven-and-the-pom</module>
    <module>chapters/02-first-spring-boot-app</module>
    <module>chapters/03-beans-and-the-application-context</module>
    <module>chapters/04-dependency-injection</module>
    <module>chapters/05-configuration-and-profiles</module>
    <module>chapters/06-how-auto-configuration-works</module>
    <module>chapters/07-the-bean-lifecycle</module>
    <module>chapters/08-how-spring-handles-requests</module>
    <module>chapters/09-requests-and-responses</module>
    <module>chapters/10-layers-and-dtos</module>
    <module>chapters/11-updating-and-deleting</module>
    <module>chapters/12-validating-input</module>
    <module>chapters/13-handling-errors</module>
    <module>chapters/14-filters-and-interceptors</module>
    <module>chapters/15-plain-sql-with-jdbcclient</module>
    <module>chapters/16-jpa-entities</module>
    <module>chapters/17-repositories-and-query-methods</module>
    <module>chapters/18-pagination-and-sorting</module>
    <module>chapters/19-projections-and-aggregations</module>
    <module>chapters/20-entity-relationships</module>
    <module>chapters/21-cascading-and-transactions</module>
    <module>chapters/22-the-persistence-context</module>
    <module>chapters/23-fetching-and-the-n-plus-1-problem</module>
    <module>chapters/24-spring-security-basics</module>
    <module>chapters/25-users-from-the-database</module>
    <module>chapters/26-jwt-fundamentals</module>
    <module>chapters/27-jwt-login-and-the-jwt-filter</module>
    <module>chapters/28-roles-and-authorities</module>
    <module>chapters/29-method-security</module>
    <module>chapters/30-access-and-refresh-tokens</module>
    <module>chapters/31-security-errors</module>
    <module>chapters/32-caching</module>
    <module>chapters/33-transactions-and-locking</module>
    <module>chapters/34-aop</module>
    <module>chapters/35-calling-other-services-with-restclient</module>
    <module>chapters/36-actuator</module>
    <module>chapters/37-events-and-scheduling</module>
    <module>chapters/38-project-the-transfers-service</module>
    <module>chapters/39-project-secure-transfers</module>
  </modules>
</project>
